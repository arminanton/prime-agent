# Prime Agent daemon environment (Deploy A). NOT applied by the fix branch. Adjust paths to
# the real prod checkout before use. Every value is opt-in and reversible.
#
# CRITICAL PLACEMENT: PRIME_AGENT_DAEMON_SCOPE, PRIME_AGENT_KERNEL_VENV, and
# PRIME_AGENT_RUNTIME_SOURCE are read by the LAUNCHING shell (the CLI process that spawns the
# daemon in cli/daemon-launch.ts), NOT by a systemd unit EnvironmentFile. Put them in the LOGIN
# environment of EVERY shell that may start the daemon (~/.bash_profile / ~/.profile, or the
# launcher wrapper). If only some shells set them, a shell-driven ensureDaemonRunning spawn is
# unscoped and back in the SSH login scope - the exact thing this prevents. And because
# collectDaemonLaunchEnv forwards the client shell's whole environment and launchWorker spreads
# it OVER the supervisor env, a stray PRIME_AGENT_KERNEL_VENV or PRIME_AGENT_RUNTIME_SOURCE in
# ONE client shell (for example a prime-next test shell) redirects that worker's venv family and
# runtime source. Keep these identical in every launching shell, or unset them everywhere.

# --- Launcher cgroup scope (A.1, cli/daemon-launch.ts buildDaemonScopeInvocation) ---
# When 1, the daemon launch is wrapped in `systemd-run --user --scope --slice=prime-agent.slice`
# so the supervisor, all workers, kernels, and uv helpers inherit ONE memory-bounded cgroup that
# a shell-driven restart cannot drop back into the SSH login scope. The scope is auto-named (no
# fixed unit that would collide on a rapid restart or when the in-scope update coordinator
# restarts the successor). If systemd-run is missing or not executable, or a scoped spawn exits
# before the socket appears, it falls back to an UNSCOPED launch with a loud client-errors-log
# warning - so containment is best-effort in code and MUST be verified at cutover
# (DEPLOY-A-RUNBOOK.md) before the user-400.slice soft cap is removed.
PRIME_AGENT_DAEMON_SCOPE=1
# Optional: override the parent slice name (default prime-agent.slice). The caps live on the
# SLICE (set ONCE by the deploy, see DEPLOY-A-RUNBOOK.md and prime-agent.slice), NOT on each
# scope, so overlapping old and new scopes during a restart share ONE cap and adopted workers in
# old scopes still count. Provisional slice caps: MemoryMax=46G (leaves ~14G of 60.4G),
# MemorySwapMax=1G (swap thrash IS the freeze; keep it tiny), memory.oom.group default 0 (kill
# the single largest process, not the whole daemon tree). All numbers are PROVISIONAL pending a
# measured cutover gate; ratchet down only after Deploy B lands the crash-loop breaker.
# PRIME_AGENT_DAEMON_SLICE=prime-agent.slice

# --- Load-generator bounds ---
# Cap concurrent kernel bootstraps so a wake/hydration wave cannot start many uv builds or
# Python kernels at once (default is min(16, max(4, cpus*2))).
PRIME_AGENT_MAX_CONCURRENT_KERNEL_BOOTS=2

# Effectively disable worker self-exit on a lost supervisor until Deploy B lands
# completion-based termination (24h here). A large value keeps a supervisor-orphaned worker
# alive instead of exiting mid-run; 0 would exit immediately. See A.4 in daemon-mode.ts.
PRIME_AGENT_INTERNAL_WORKER_SUPERVISOR_LOST_EXIT_MS=86400000

# --- Kernel venv (A.2) ---
# Per-checkout kernel venv so a version upgrade (a new checkout) never rebuilds or shares the
# previous checkout's venv. Point EACH checkout at its own base path; A.2 builds versioned
# generation dirs (<base>-<hash>-<nonce>) beside it and publishes a <base>.current pointer, and
# never removes a dir the pointer names.
PRIME_AGENT_KERNEL_VENV=/home/ndsadmin/.prime/agent/kernel-venv-prod
# Install prime-agent-runtime from this checkout's source instead of the bundled copy, so a
# moved/removed worktree fails clean (A.2 #2203) instead of tearing down the shared venv. Point
# at the checkout's prime-agent-runtime SOURCE (repo root) or its built dist copy; the previous
# .../packages/coding-agent/prime-agent-runtime path does NOT exist and would fail every kernel
# boot clean (= no kernels). Verify the path resolves before cutover.
PRIME_AGENT_RUNTIME_SOURCE=/mnt/devvm/custom/prime/prime-agent-runtime

# --- Optional overrides (leave unset for the hardened defaults) ---
# Restore eager kernel prewarm on hydration (A.5). Unset = passive daemon-hydrated child
# sessions defer the kernel start until first ipython use (the memory-wave mitigation). Roots
# still prewarm eagerly.
# PRIME_AGENT_EAGER_KERNEL_PREWARM_ON_HYDRATE=1
