# Prime Agent daemon environment (Deploy A). NOT applied by the fix branch. Source it from
# the launcher wrapper or a systemd unit EnvironmentFile at cutover. Every value is opt-in
# and reversible. Adjust paths to the real prod checkout before use.

# --- Launcher cgroup scope (A.1, cli/daemon-launch.ts buildDaemonScopeInvocation) ---
# When 1, the daemon launch is wrapped in `systemd-run --user --scope` so the supervisor,
# all workers, kernels, and uv helpers inherit ONE cgroup with a hard memory + swap cap,
# and a shell-driven restart cannot drop the daemon back into the SSH login scope.
# Falls back to the unscoped launch (with a client-errors-log warning) if systemd-run is
# absent, so it is safe to set unconditionally.
PRIME_AGENT_DAEMON_SCOPE=1
# Hard caps for that scope. Start MemoryMax ABOVE the measured legit steady state
# (sample the scope's memory.current + memory.swap.current for ~1 week via
# telemetry-sampler.sh) and ratchet down only after Deploy B lands the crash-loop breaker
# and completion-based termination. MemorySwapMax keeps a runaway from thrashing 64G of
# swap before the kernel OOM killer acts.
PRIME_AGENT_DAEMON_SCOPE_MEMORY_MAX=46G
PRIME_AGENT_DAEMON_SCOPE_MEMORY_SWAP_MAX=6G

# --- Load-generator bounds ---
# Cap concurrent kernel bootstraps so a wake/hydration wave cannot start many uv builds or
# Python kernels at once (default is min(16, max(4, cpus*2))).
PRIME_AGENT_MAX_CONCURRENT_KERNEL_BOOTS=2

# Effectively disable worker self-exit on a lost supervisor until Deploy B lands
# completion-based termination (24h here). A large value keeps a supervisor-orphaned worker
# alive instead of exiting mid-run; 0 would exit immediately. See A.4 in daemon-mode.ts.
PRIME_AGENT_INTERNAL_WORKER_SUPERVISOR_LOST_EXIT_MS=86400000

# --- Kernel venv (A.2) ---
# Per-checkout kernel venv so a version upgrade (a new checkout) never rebuilds or shares
# the previous checkout's venv. Point EACH checkout at its own base path; A.2 builds
# versioned generation dirs (<base>-<hash>) beside it and publishes a <base>.current pointer.
PRIME_AGENT_KERNEL_VENV=/home/ndsadmin/.prime/agent/kernel-venv-prod
# Install prime-agent-runtime from this checkout's source instead of the bundled copy, so a
# moved/removed worktree fails clean (A.2 #2203) instead of tearing down the shared venv.
PRIME_AGENT_RUNTIME_SOURCE=/mnt/devvm/custom/prime/packages/coding-agent/prime-agent-runtime

# --- Optional overrides (leave unset for the hardened defaults) ---
# Restore eager kernel prewarm on hydration (A.5). Unset = passive daemon-hydrated sessions
# defer the kernel start until first ipython use (the memory-wave mitigation).
# PRIME_AGENT_EAGER_KERNEL_PREWARM_ON_HYDRATE=1
